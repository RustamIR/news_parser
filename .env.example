# --- Телеграм-бот (BotFather) ---
TELEGRAM_TOKEN="123456:AA..."

# ID пользователей, которым разрешён доступ к боту (через запятую).
# Свой ID можно узнать у @userinfobot. Если пусто — доступ открыт всем (не рекомендуется).
ADMIN_IDS="123456789"

# --- Telethon (парсинг телеграм-каналов от имени аккаунта) ---
# Получить на https://my.telegram.org -> API development tools
TELEGRAM_API_ID=""
TELEGRAM_API_HASH=""
# Заполняется автоматически после запуска `python login_telegram.py`
TELEGRAM_SESSION=""

# --- Анализ постов (опционально) ---
# Кто оценивает релевантность и пишет резюме:
#   auto   — сначала локальная модель Ollama, если её нет — Claude (по умолчанию)
#   ollama — только локальная модель
#   claude — только облачный Claude
#   none   — без модели, фильтр только по ключевым словам
LLM_BACKEND="auto"

# Локальная модель: бесплатно, офлайн, медленнее облака.
# Установка: brew install ollama && ollama serve && ollama pull qwen3:8b
OLLAMA_URL="http://localhost:11434"
OLLAMA_MODEL="qwen3:8b"

# Облачный Claude: точнее на пограничных постах, но платно по токенам.
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-opus-5"

# --- Прочее ---
DB_PATH="news_parser.sqlite3"
# Интервал опроса по умолчанию для новых рубрик, минут
DEFAULT_POLL_INTERVAL=30
# Порог релевантности по умолчанию (0-100)
DEFAULT_MIN_RELEVANCE=60
LOG_LEVEL="INFO"
